# Socrata app token (recommended). Leave blank to use the public API without a token.
SOCRATA_APP_TOKEN=

# PostgreSQL configuration used by compose.yaml and check_postgres.py.
# Host port 5433 avoids conflicting with an existing local PostgreSQL container on 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=crime_db
POSTGRES_USER=crime_user
POSTGRES_PASSWORD=change_this_to_a_strong_local_password
